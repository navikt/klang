{
  "name": "klang-server",
  "version": "1.0.0",
  "private": true,
  "author": "NAV",
  "license": "MIT",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "bun run build --watch & NAIS_CLUSTER_NAME=local node --watch --trace-warnings dist/server.js",
    "build": "tsc --outdir dist --sourcemap && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "lint": "biome check"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/http-proxy": "11.6.1",
    "@fastify/otel": "0.20.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@navikt/oasis": "4.1.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/instrumentation-dns": "0.64.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-net": "0.65.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "fastify": "5.12.1",
    "fastify-metrics": "13.2.1",
    "happy-dom": "20.12.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "25.9.5",
    "tsc-alias": "1.9.2",
    "typescript": "7.0.2"
  }
}
