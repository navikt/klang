{
  "name": "klang-server",
  "version": "1.0.0",
  "private": true,
  "author": "NAV",
  "license": "MIT",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "bun run build --watch & NAIS_CLUSTER_NAME=local node --watch --trace-warnings dist/server.js",
    "build": "tsc --outdir dist --sourcemap && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "lint": "biome check"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/http-proxy": "11.6.5",
    "@fastify/otel": "0.21.4",
    "@fastify/type-provider-typebox": "6.3.0",
    "@navikt/oasis": "4.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.300.0",
    "@opentelemetry/instrumentation-dns": "0.67.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-net": "0.68.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "fastify": "5.12.7",
    "fastify-metrics": "14.1.1",
    "happy-dom": "21.0.4",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "tsc-alias": "1.9.9",
    "typescript": "7.0.2"
  }
}
